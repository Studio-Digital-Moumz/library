   {
    "accountId": "6302768812",
    "containerId": "224269921",
    "variableId": "108",
    "name": "JS - Type de page",
    "type": "jsm",
    "parameter": [
     {
      "type": "TEMPLATE",
      "key": "javascript",
      "value": "function() {\n  var p = location.pathname.replace(/\\/+$/, '') || '/';\n  if (p === '/') return 'accueil';\n  if (/^\\/article\\//.test(p)) return 'article';\n  if (/^\\/category\\//.test(p)) return 'categorie_blog';\n  if (/^\\/projets\\//.test(p)) return 'projet';\n  if (/^\\/legales\\//.test(p)) return 'legal';\n  if (/^\\/(creation-de-site-webflow|landing-page|refonte-de-site-web|site-shopify|optimisation-site-web|referencement-seo-geo|google-ads|audit-strategie-web)$/.test(p)) return 'service';\n  var m = { '/blog': 'blog', '/realisations': 'realisations', '/tarifs': 'tarifs', '/contact': 'contact', '/merci': 'merci', '/agence': 'agence', '/moumz-en-bref': 'moumz_en_bref' };\n  return m[p] || 'autre';\n}"
     }
    ],
    "parentFolderId": "106",
    "formatValue": {}
   },
   {
    "accountId": "6302768812",
    "containerId": "224269921",
    "variableId": "109",
    "name": "JS - Catégorie d'article",
    "type": "jsm",
    "parameter": [
     {
      "type": "TEMPLATE",
      "key": "javascript",
      "value": "function() {\n  var a = document.querySelector('.section_post-hero a[href^=\"/category/\"]');\n  if (!a) return undefined;\n  return a.getAttribute('href').replace('/category/', '').replace(/\\/+$/, '');\n}"
     }
    ],
    "parentFolderId": "106",
    "formatValue": {}
   },
   {
    "accountId": "6302768812",
    "containerId": "224269921",
    "variableId": "110",
    "name": "JS - Service lié",
    "type": "jsm",
    "parameter": [
     {
      "type": "TEMPLATE",
      "key": "javascript",
      "value": "function() {\n  var p = location.pathname.replace(/\\/+$/, '');\n  if (/^\\/(creation-de-site-webflow|landing-page|refonte-de-site-web|site-shopify|optimisation-site-web|referencement-seo-geo|google-ads|audit-strategie-web)$/.test(p)) return p.slice(1);\n  var a = document.querySelector('.blog-service_component a[href]');\n  if (!a) return undefined;\n  return a.getAttribute('href').replace(/^\\//, '').replace(/\\/+$/, '');\n}"
     }
    ],
    "parentFolderId": "106",
    "formatValue": {}
   },
   {
    "accountId": "6302768812",
    "containerId": "224269921",
    "variableId": "111",
    "name": "JS - Emplacement du clic",
    "type": "jsm",
    "parameter": [
     {
      "type": "TEMPLATE",
      "key": "javascript",
      "value": "function() {\n  var el = {{Click Element}};\n  if (!el || !el.closest) return 'autre';\n  if (el.closest('.navbar')) return 'navbar';\n  if (el.closest('footer')) return 'footer';\n  if (el.closest('.blog-service_component')) return 'article_carte_service';\n  if (el.closest('.post-body_rich .post-strip_card')) return 'article_encart';\n  if (el.closest('.post-body_rich')) return 'article_texte';\n  if (el.closest('.section_post-strip')) return 'article_bandeau_fin';\n  var s = el.closest('section');\n  if (s) { var m = String(s.className).match(/section_([a-z0-9-]+)/); if (m) return m[1].replace(/-/g, '_'); }\n  return 'autre';\n}"
     }
    ],
    "parentFolderId": "106",
    "formatValue": {}
   },
   {
    "accountId": "6302768812",
    "containerId": "224269921",
    "variableId": "112",
    "name": "JS - Destination du clic",
    "type": "jsm",
    "parameter": [
     {
      "type": "TEMPLATE",
      "key": "javascript",
      "value": "function() {\n  var u = {{Click URL}} || '';\n  if (/^tel:/.test(u)) return 'telephone';\n  if (/^mailto:/.test(u)) return 'email';\n  var a = document.createElement('a'); a.href = u;\n  if (a.hostname && a.hostname !== location.hostname) return a.hostname;\n  return (a.pathname || '/').replace(/\\/+$/, '') || '/';\n}"
     }
    ],
    "parentFolderId": "106",
    "formatValue": {}
   },
   {
    "accountId": "6302768812",
    "containerId": "224269921",
    "variableId": "113",
    "name": "JS - Trafic interne",
    "type": "jsm",
    "parameter": [
     {
      "type": "TEMPLATE",
      "key": "javascript",
      "value": "function() {\n  // Visites de l'équipe : ouvrir une page avec ?mz-interne=1 pour s'exclure sur ce navigateur, ?mz-interne=0 pour revenir en arrière.\n  try {\n    var q = location.search.match(/[?&]mz-interne=([01])/);\n    if (q) { if (q[1] === '1') localStorage.setItem('mz-interne', '1'); else localStorage.removeItem('mz-interne'); }\n    if (localStorage.getItem('mz-interne') === '1') return 'internal';\n  } catch (e) {}\n  if (/webflow\\.io$/.test(location.hostname)) return 'internal';\n  return undefined;\n}"
     }
    ],
    "parentFolderId": "102",
    "formatValue": {}
   }
