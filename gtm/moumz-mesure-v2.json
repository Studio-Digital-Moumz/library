   {
    "accountId": "6302768812",
    "containerId": "224269921",
    "tagId": "133",
    "name": "Site - Suivi de lecture d'article",
    "type": "html",
    "parameter": [
     {
      "type": "TEMPLATE",
      "key": "html",
      "value": "<script>\n(function () {\n  // Mesure la lecture du texte de l'article (.post-body_rich), pas de la page entière.\n  // article_progress : 25, 50, 75, 100 %. article_read : 75 % du texte atteint et 30 s de présence active.\n  var body = document.querySelector('.post-body_rich'); if (!body) return;\n  var marks = [25, 50, 75, 100], sent = {}, active = 0, last = Date.now(), reached = 0, read = false;\n  window.dataLayer = window.dataLayer || [];\n  function check() {\n    var now = Date.now(); if (!document.hidden) active += now - last; last = now;\n    var r = body.getBoundingClientRect(); if (!r.height) return;\n    var p = Math.max(0, Math.min(100, (window.innerHeight - r.top) / r.height * 100));\n    if (p > reached) reached = p;\n    for (var i = 0; i < marks.length; i++) {\n      if (reached >= marks[i] && !sent[marks[i]]) { sent[marks[i]] = true; window.dataLayer.push({ event: 'article_progress', article_percent: marks[i] }); }\n    }\n    if (!read && reached >= 75 && active >= 30000) { read = true; window.dataLayer.push({ event: 'article_read', article_seconds: Math.round(active / 1000) }); }\n  }\n  window.addEventListener('scroll', check, { passive: true });\n  setInterval(check, 1000); check();\n})();\n</script>"
     },
     {
      "type": "BOOLEAN",
      "key": "supportDocumentWrite",
      "value": "false"
     }
